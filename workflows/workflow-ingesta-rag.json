      "id": "2bda6bf0-d3ba-4951-9abe-944d318bce05",
      "name": "Extract from File"
    },
    {
      "parameters": {
        "jsCode": "\nconst registros = $input.all();\nconst grupos = new Map();\n\nfor (const item of registros) {\n  const r = item.json;\n  const banca = String(r.BANCA ?? \"\").trim();\n  const rubro = String(r.RUBRO ?? \"\").trim();\n\n  if (!banca || !rubro) continue;\n\n  const clave = `${banca}|${rubro}`;\n\n  if (!grupos.has(clave)) {\n    grupos.set(clave, {\n      banca,\n      rubro,\n      periodo: \"YTD_MTD\",\n      detalles: []\n    });\n  }\n\n  const detalle = [\n    `Subrubro: ${r.SUB_RUBRO ?? \"\"}`,\n    `Cuenta: ${r.CUENTA ?? \"\"}`,\n    `Nombre de cuenta: ${r.NOMBRE_CUENTA ?? \"\"}`,\n    `PLAN_YTD: ${r.PLAN_YTD ?? \"\"}`,\n    `REAL_YTD: ${r.REAL_YTD ?? \"\"}`,\n    `DESVIO_YTD: ${r.DESVIO_YTD ?? \"\"}`,\n    `PLAN_MTD: ${r.PLAN_MTD ?? \"\"}`,\n    `REAL_MTD: ${r.REAL_MTD ?? \"\"}`,\n    `DESVIO_MTD: ${r.DESVIO_MTD ?? \"\"}`\n  ].join(\" | \");\n\n  grupos.get(clave).detalles.push(detalle);\n}\n\nreturn Array.from(grupos.values()).map(g => ({\n  json: {\n    banca: g.banca,\n    rubro: g.rubro,\n    periodo: g.periodo,\n    cantidad_registros: g.detalles.length,\n    texto: [\n      `Información presupuestaria ficticia`,\n      `Banca: ${g.banca}`,\n      `Rubro: ${g.rubro}`,\n      `Períodos disponibles: YTD y MTD`,\n      `DESVIO = PLAN - REAL`,\n      `Negativo: sobregasto. Positivo: menor gasto.`,\n      `Los importes siguientes son por registro, no totales.`,\n      ...g.detalles\n    ].join(\"\\n\")\n  }\n}));\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        272,
        0
      ],
